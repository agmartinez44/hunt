<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  /* Harvard-style consultant CV: centered serif header, ALL-CAPS underlined
     section heads, single column, right-aligned dates, no graphics. */
  @page {
    size: A4;
    margin: 18mm 19mm 20mm 19mm;
    @bottom-center {
      content: counter(page) " of " counter(pages);
      font-family: "Liberation Serif", "DejaVu Serif", serif;
      font-size: 8pt; color: #444;
      vertical-align: top; margin-top: 5mm;
    }
  }

  * { box-sizing: border-box; }
  html { orphans: 2; widows: 2; }
  body {
    font-family: "Liberation Serif", "Times New Roman", "DejaVu Serif", serif;
    font-size: 9.8pt; line-height: 1.34; color: #111; margin: 0;
    -weasy-hyphens: none;
  }
  a { color: inherit; text-decoration: none; }

  /* ---- header ---- */
  header { text-align: center; }
  h1 {
    font-size: 15.5pt; letter-spacing: .06em; text-transform: uppercase;
    font-weight: bold; color: #111; margin: 0;
  }
  .headline { font-size: 10.5pt; color: #222; margin-top: 2pt; font-style: italic; }
  .contact { font-size: 9pt; color: #111; margin-top: 3pt; }
  .contact span + span::before { content: "\00A0|\00A0"; color: #555; }
  .head-rule { border-bottom: 1.1pt solid #111; margin-top: 6pt; }

  /* ---- sections ---- */
  section { margin-top: 10pt; }
  h2 {
    text-align: center; font-size: 10pt; letter-spacing: .09em;
    text-transform: uppercase; color: #111; font-weight: bold;
    border-bottom: .8pt solid #111; padding-bottom: 1.5pt;
    margin: 0 0 5pt;
  }

  /* experience entries */
  .job { break-inside: avoid; margin-bottom: 7.5pt; }
  .job-line { display: flex; justify-content: space-between; align-items: baseline; }
  .job-title { font-weight: bold; font-size: 9.9pt; }
  .job-title .sep { font-weight: normal; color: #333; }
  .dates { white-space: nowrap; font-size: 9.4pt; }
  ul { margin: 2pt 0 0 0; padding-left: 14pt; list-style-type: disc; }
  li { margin-bottom: 1.8pt; padding-left: 1pt; }
  li::marker { color: #111; }

  /* compact list sections */
  ul.plain { list-style: none; padding-left: 0; margin-top: 2pt; }
  ul.plain li { margin-bottom: 1.5pt; }
  .muted { color: #333; }

  /* skills detail lines */
  .skills p { margin: 1.6pt 0; display: flex; }
  .skills b { flex: 0 0 132pt; font-weight: bold; }
  .skills span { flex: 1; }

  .avoid-break { break-inside: avoid; }
</style>
</head>
<body>
<header>
  <h1>{{ name }}</h1>
  <div class="headline">{{ headline }}</div>
  <div class="contact">{% for c in contact_items %}<span>{{ c }}</span>{% endfor %}</div>
  <div class="head-rule"></div>
</header>

{% if profile_text %}
<section><p style="margin:0">{{ profile_text }}</p></section>
{% endif %}

<section>
  <h2>Professional Experience</h2>
  {% for job in jobs %}
  <div class="job avoid-break">
    <div class="job-line">
      <span class="job-title">{{ job.title }}, <span class="sep">{{ job.employer }}{% if job.location %}, {{ job.location }}{% endif %}</span></span>
      <span class="dates">{{ job.dates }}</span>
    </div>
    <ul>{% for a in job.bullets %}<li>{{ a.text }}</li>{% endfor %}</ul>
  </div>
  {% endfor %}
</section>

{% if projects %}
<section><h2>Projects</h2>
  {% for p in projects %}<p class="avoid-break" style="margin:2.5pt 0"><b>{{ p.name }}.</b> {{ p.summary }}</p>{% endfor %}
</section>
{% endif %}

{% if certifications %}
<section class="avoid-break"><h2>Certifications</h2>
<ul class="plain">{% for c in certifications %}<li>{{ c.name }}{% if c.year %} <span class="muted">({{ c.year }})</span>{% endif %}</li>{% endfor %}</ul>
</section>
{% endif %}

<section class="avoid-break"><h2>Education</h2>
<ul class="plain">{% for e in education %}<li>{{ e.degree }}, {{ e.institution }}</li>{% endfor %}</ul>
</section>

{% if skill_lines %}
<section class="skills"><h2>Skills</h2>
  {% for line in skill_lines %}<p><b>{{ line.group }}:</b> <span>{{ line.skills_text }}</span></p>{% endfor %}
</section>
{% endif %}

{% if languages %}
<section class="avoid-break"><h2>Languages</h2>
<p style="margin-top:2pt">{% for l in languages %}{{ l.name }} ({% if l.level == 'native' %}native{% else %}{{ l.level }}{% endif %}){% if not loop.last %}, {% endif %}{% endfor %}</p>
</section>
{% endif %}
</body>
</html>
